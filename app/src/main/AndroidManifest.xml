<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal (install-time) permissions only, apart from storage for saving the report. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Self-update: download from GitHub Releases, then ask Android's installer. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Voice chat with ChatGPT. Asked for the first time you start a call. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!--
          SAFETY: no CATEGORY_HOME filter. FridgeDash is an ordinary app,
          so installing it cannot change or reset the default Home app.
          The Hisense Home stays the default and the Home button keeps working.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppsActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".VoiceActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme.Fullscreen" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics" />

        <provider
            android:name=".ApkProvider"
            android:authorities="app.fridgedash.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
