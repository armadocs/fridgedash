<?xml version="1.0" encoding="utf-8"?>
<!--
  Home screen. Sizes are in dp on a fixed 540dp-wide canvas (BaseActivity scales
  it to the real panel), i.e. half the pixel sizes of the 1080x1920 mockup.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF070B14">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2E050812" />

    <View
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="@drawable/scrim_top" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:format12Hour="h:mm"
                    android:format24Hour="H:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:textColor="#FFF4F6FB"
                    android:textSize="66sp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="#DBF4F6FB"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical"
                android:paddingBottom="3dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Weather: tap for the forecast -->
                    <app.fridgedash.GlassLayout
                        android:id="@+id/weatherCard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:contentDescription="Weather forecast"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        app:glassRadius="18dp">

                        <TextView
                            android:id="@+id/weatherIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="⛅"
                            android:textSize="26sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/weatherTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-light"
                                android:includeFontPadding="false"
                                android:text="—°"
                                android:textColor="#FFF4F6FB"
                                android:textSize="26sp" />

                            <TextView
                                android:id="@+id/weatherSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="150dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Weather"
                                android:textColor="#DBF4F6FB"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </app.fridgedash.GlassLayout>

                    <app.fridgedash.GlassLayout
                        android:id="@+id/btnSettings"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:contentDescription="FridgeDash settings"
                        android:focusable="true"
                        android:gravity="center"
                        app:glassPill="true">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_settings" />
                    </app.fridgedash.GlassLayout>
                </LinearLayout>

                <app.fridgedash.GlassLayout
                    android:id="@+id/creditChip"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    app:glassPill="true">

                    <ImageView
                        android:id="@+id/wifiIcon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="Wi-Fi"
                        android:src="@drawable/ic_wifi"
                        android:tint="#FF5ED3C4" />

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_image"
                        android:tint="#DBF4F6FB" />

                    <TextView
                        android:id="@+id/creditText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:ellipsize="end"
                        android:maxWidth="190dp"
                        android:maxLines="1"
                        android:textColor="#DBF4F6FB"
                        android:textSize="8.5sp" />
                </app.fridgedash.GlassLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Update notice -->
        <app.fridgedash.GlassLayout
            android:id="@+id/updateBannerBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:glassRadius="16dp"
            app:glassTint="#992D7FF9">

            <TextView
                android:id="@+id/updateBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="40dp"
                android:padding="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </app.fridgedash.GlassLayout>

        <!-- Today -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/todayColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Dock: talk button in the centre, small menu on an arc -->
        <FrameLayout
            android:layout_width="540dp"
            android:layout_height="125dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="-24dp"
            android:layout_marginEnd="-24dp">

            <View
                android:layout_width="540dp"
                android:layout_height="125dp"
                android:background="@drawable/scrim_bottom" />

            <app.fridgedash.GlassLayout
                android:id="@+id/dockFridge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="68dp"
                android:layout_marginTop="48dp"
                android:clickable="true"
                android:contentDescription="Refrigerator"
                android:focusable="true"
                android:gravity="center"
                app:glassPill="true">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_fridge" />
            </app.fridgedash.GlassLayout>

            <TextView
                style="@style/DockLabel"
                android:layout_marginStart="50dp"
                android:layout_marginTop="96dp"
                android:text="Fridge" />

            <app.fridgedash.GlassLayout
                android:id="@+id/dockHome"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="153dp"
                android:layout_marginTop="23dp"
                android:clickable="true"
                android:contentDescription="Home Assistant"
                android:focusable="true"
                android:gravity="center"
                app:glassPill="true">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_home" />
            </app.fridgedash.GlassLayout>

            <TextView
                style="@style/DockLabel"
                android:layout_marginStart="135dp"
                android:layout_marginTop="71dp"
                android:text="Home" />

            <View
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_marginStart="218dp"
                android:layout_marginTop="-2dp"
                android:background="@drawable/talk_ring" />

            <FrameLayout
                android:id="@+id/dockTalk"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="235dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/talk_button"
                android:clickable="true"
                android:contentDescription="Talk to ChatGPT"
                android:elevation="8dp"
                android:focusable="true">

                <ImageView
                    android:id="@+id/talkIcon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wave"
                    android:tint="#FF0B1020" />
            </FrameLayout>

            <TextView
                style="@style/DockLabel"
                android:layout_width="120dp"
                android:layout_marginStart="210dp"
                android:layout_marginTop="96dp"
                android:fontFamily="sans-serif-medium"
                android:text="Ask ChatGPT"
                android:textColor="#FFF4F6FB"
                android:textSize="10sp" />

            <app.fridgedash.GlassLayout
                android:id="@+id/dockCalendar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="343dp"
                android:layout_marginTop="23dp"
                android:clickable="true"
                android:contentDescription="Calendar"
                android:focusable="true"
                android:gravity="center"
                app:glassPill="true">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar" />
            </app.fridgedash.GlassLayout>

            <TextView
                style="@style/DockLabel"
                android:layout_marginStart="325dp"
                android:layout_marginTop="71dp"
                android:text="Calendar" />

            <app.fridgedash.GlassLayout
                android:id="@+id/dockApps"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="428dp"
                android:layout_marginTop="48dp"
                android:clickable="true"
                android:contentDescription="All apps"
                android:focusable="true"
                android:gravity="center"
                app:glassPill="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_apps" />
            </app.fridgedash.GlassLayout>

            <TextView
                style="@style/DockLabel"
                android:layout_marginStart="410dp"
                android:layout_marginTop="96dp"
                android:text="Apps" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
